# 复制为 .env 后修改；.env 不入 git
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# OKX 采集（P0-2）；国内拉行情需本地代理，无代理则留空
OKX_PROXY=http://127.0.0.1:7897
# 自选池：内部规范 base/quote；永续由适配器自动拼 :USDT
SYMBOLS=BTC/USDT,ETH/USDT,ONDO/USDT,LINK/USDT
CONTRACT_TYPES=spot,perp
TIMEFRAMES=1m,1h,4h,1d
BACKFILL_DAYS=30
# 自选池扩展：市值(quoteVolume) TOP N 自动加入（0=关闭）
POOL_TOP_N=5
# 企业微信机器人 webhook（群机器人 → 添加 → 复制 URL）；留空=只打印不推送
WECOM_WEBHOOK=
# 飞书自定义机器人 webhook（群设置 → 群机器人 → 添加 → 复制 URL）；留空=不推飞书
FEISHU_WEBHOOK=
# 飞书签名校验密钥（机器人安全设置勾选"签名校验"时填写，否则留空）
FEISHU_SECRET=

# P2 LLM（阿里百炼 Qwen，OpenAI 兼容端点）；key 留空=LLM 功能降级跳过
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 逗号分隔多个模型 = 回退链（前一个失败自动换下一个）
LLM_MODEL_EXTRACT=qwen-plus
LLM_MODEL_EXPLAIN=qwen-plus
LLM_MODEL_VISION=qwen-vl-max
